#include "qca953x.dtsi"

#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/input/input.h>
#include <dt-bindings/leds/common.h>

/ {
	compatible = "datto,mp60", "qca,qca9533";
	model = "Datto MP60";

	chosen {
		/delete-property/ bootargs;
	};

	aliases {
		serial0 = &uart;
		label-mac-device = &eth0;
		led-boot = &led_power_blue;
		led-failsafe = &led_power_blue;
		led-running = &led_power_blue;
		led-upgrade = &led_power_blue;
	};

	keys {
		compatible = "gpio-keys";
		pinctrl-names = "default";
		pinctrl-0 = <&jtag_disable_pins>;

		reset {
			label = "reset";
			linux,code = <KEY_RESTART>;
			gpios = <&gpio 1 GPIO_ACTIVE_LOW>;
			debounce-interval = <5>;
		};
	};

	leds {
		compatible = "gpio-leds";

		led_power_blue: power_blue {
			function = LED_FUNCTION_POWER;
			color = <LED_COLOR_ID_BLUE>;
			gpios = <&gpio 0 GPIO_ACTIVE_LOW>;
			default-state = "on";
		};

		wifi_green {
			function = LED_FUNCTION_WLAN;
			color = <LED_COLOR_ID_GREEN>;
			gpios = <&gpio 2 GPIO_ACTIVE_LOW>;
			linux,default-trigger = "phy0tpt";
		};

		status_yellow {
			function = LED_FUNCTION_STATUS;
			color = <LED_COLOR_ID_YELLOW>;
			gpios = <&gpio 3 GPIO_ACTIVE_LOW>;
		};

		status_red {
			function = LED_FUNCTION_STATUS;
			color = <LED_COLOR_ID_RED>;
			gpios = <&gpio 4 GPIO_ACTIVE_LOW>;
		};
	};

	watchdog {
		compatible = "linux,wdt-gpio";
		gpios = <&gpio 12 GPIO_ACTIVE_LOW>;
		hw_algo = "toggle";
		/* The hardware margin is 300s; the driver limits it to 60s. */
		hw_margin_ms = <60000>;
		always-running;
	};
};

&gpio {
	pinctrl-names = "default";
	pinctrl-0 = <&mp60_i2c_pins>;
};

&pinmux {
	mp60_i2c_pins: pinmux-mp60-i2c {
		/* Legacy P60 setup selects GPIO function 0 on GPIO11 and GPIO14.
		 * mp60d uses these pins directly with the GPIO-v2 character device. */
		pinctrl-single,bits = <0x08 0x0 0xff000000>,
				      <0x0c 0x0 0x00ff0000>;
	};
};

&spi {
	status = "okay";

	flash@0 {
		compatible = "jedec,spi-nor";
		reg = <0>;
		spi-max-frequency = <25000000>;

		partitions {
			compatible = "fixed-partitions";
			#address-cells = <1>;
			#size-cells = <1>;

			partition@0 {
				label = "u-boot";
				reg = <0x000000 0x040000>;
				read-only;
			};

			partition@40000 {
				label = "u-boot-env";
				reg = <0x040000 0x040000>;
			};

			partition@80000 {
				label = "custom";
				reg = <0x080000 0x140000>;
				read-only;
			};

			partition@1c0000 {
				label = "inactive";
				reg = <0x1c0000 0x700000>;
			};

			partition@8c0000 {
				label = "inactive2";
				reg = <0x8c0000 0x700000>;
			};

			partition@fc0000 {
				label = "ART";
				reg = <0xfc0000 0x040000>;
				read-only;

				nvmem-layout {
					compatible = "fixed-layout";
					#address-cells = <1>;
					#size-cells = <1>;

					macaddr_art_0: macaddr@0 {
						compatible = "mac-base";
						reg = <0x0 0x6>;
						#nvmem-cell-cells = <1>;
					};

					cal_art_1000: calibration@1000 {
						reg = <0x1000 0x440>;
					};
				};
			};
		};
	};
};

&eth0 {
	status = "okay";

	phy-handle = <&swphy4>;

	nvmem-cells = <&macaddr_art_0 0>;
	nvmem-cell-names = "mac-address";
};

&eth1 {
	/* Keep MDIO/switch topology without probing the unused fixed-link GMAC.
	 * Otherwise it can claim eth0 before the real PHY4 port at 0x19000000.
	 */
	compatible = "syscon", "simple-mfd";
};

&wdt {
	status = "disabled";
};

&wmac {
	status = "okay";

	nvmem-cells = <&macaddr_art_0 2>, <&cal_art_1000>;
	nvmem-cell-names = "mac-address", "calibration";
};
